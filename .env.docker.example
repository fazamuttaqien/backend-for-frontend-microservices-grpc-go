BFF_HTTP_PORT=8080

POSTGRES_USER=user
POSTGRES_PASSWORD=change-me

USER_DATABASE_URL=postgres://user:change-me@postgres:5432/user_service
PRODUCT_DATABASE_URL=postgres://user:change-me@postgres:5432/product_service
ORDER_DATABASE_URL=postgres://user:change-me@postgres:5432/order_service

USER_GRPC_PORT=50051
PRODUCT_GRPC_PORT=50052
ORDER_GRPC_PORT=50053

USER_SERVICE_ADDRESS=user-service:50051
PRODUCT_SERVICE_ADDRESS=product-service:50052
ORDER_SERVICE_ADDRESS=order-service:50053

REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT_MS=100
PRODUCT_CACHE_TTL_SECONDS=60

RABBITMQ_USER=app
RABBITMQ_PASSWORD=change-me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Go applications send OTLP/gRPC directly to Grafana Alloy over Docker DNS.
OTEL_EXPORTER_OTLP_ENDPOINT=alloy:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
BFF_OTEL_RESOURCE_ATTRIBUTES=service.name=bff,deployment.environment=docker
USER_OTEL_RESOURCE_ATTRIBUTES=service.name=user-service,deployment.environment=docker
PRODUCT_OTEL_RESOURCE_ATTRIBUTES=service.name=product-service,deployment.environment=docker
ORDER_OTEL_RESOURCE_ATTRIBUTES=service.name=order-service,deployment.environment=docker

JWT_SECRET=
JWT_ISSUER=user-service
JWT_TTL_MINUTES=60

AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
