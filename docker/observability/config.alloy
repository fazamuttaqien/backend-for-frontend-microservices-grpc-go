logging {
  level  = "info"
  format = "logfmt"
}

otelcol.receiver.faro "frontend" {
  endpoint = "0.0.0.0:12348"

  cors {
    allowed_origins = [coalesce(sys.env("FARO_ALLOWED_ORIGIN"), "http://localhost:8080")]
    allowed_headers = ["Content-Type", "Traceparent", "X-Faro-Session-Id"]
    max_age         = 3600
  }

  output {
    logs   = [otelcol.processor.memory_limiter.default.input]
    traces = [otelcol.processor.memory_limiter.default.input]
  }
}

otelcol.receiver.otlp "default" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }

  output {
    metrics = [otelcol.processor.memory_limiter.default.input]
    logs    = [otelcol.processor.memory_limiter.default.input]
    traces  = [otelcol.processor.memory_limiter.default.input]
  }
}

otelcol.processor.memory_limiter "default" {
  check_interval         = "1s"
  limit_percentage       = 80
  spike_limit_percentage = 20

  output {
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.logs.input]
    traces  = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  send_batch_size = 512
  timeout         = "5s"

  output {
    metrics = [otelcol.exporter.otlphttp.mimir.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
  }
}

// OTLP and Faro application logs are routed to the same self-hosted Loki backend.
// Labels are intentionally kept low-cardinality.
otelcol.processor.batch "logs" {
  send_batch_size = 512
  timeout         = "5s"

  output {
    logs = [otelcol.exporter.loki.local.input]
  }
}

// Metrics: OTLP HTTP to the local Mimir OTLP endpoint.
otelcol.exporter.otlphttp "mimir" {
  client {
    endpoint = "http://mimir:9009/otlp"
    timeout  = "10s"
  }

  retry_on_failure {
    enabled          = true
    initial_interval = "1s"
    max_interval     = "30s"
    max_elapsed_time = "5m"
  }

  sending_queue {
    enabled       = true
    queue_size    = 1000
    num_consumers = 4
  }
}

// Traces: OTLP gRPC to the local Tempo OTLP receiver.
otelcol.exporter.otlp "tempo" {
  timeout = "10s"

  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }

  retry_on_failure {
    enabled          = true
    initial_interval = "1s"
    max_interval     = "30s"
    max_elapsed_time = "5m"
  }

  sending_queue {
    enabled       = true
    queue_size    = 1000
    num_consumers = 4
  }
}

// OTLP/Faro logs -> Loki bridge. Delivery retry/queueing is handled by loki.write.
otelcol.exporter.loki "local" {
  forward_to = [loki.write.local.receiver]
}

discovery.docker "backend" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "backend_logs" {
  targets = discovery.docker.backend.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(bff|user-service|product-service|order-service|notification-consumer)"
    target_label  = "service_name"
  }

  rule {
    target_label = "environment"
    replacement  = "development"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(bff|user-service|product-service|order-service|notification-consumer)"
    action        = "keep"
  }
}

loki.source.docker "backend_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.backend_logs.output
  forward_to = [loki.process.backend_logs.receiver]
}

loki.process "backend_logs" {
  stage.docker { }

  stage.json {
    expressions = {
      trace_id = "trace_id",
      span_id  = "span_id",
      level    = "level",
    }
  }

  // Correlation identifiers are structured metadata, not Loki labels.
  stage.structured_metadata {
    values = {
      trace_id = "",
      span_id  = "",
    }
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  forward_to = [loki.write.local.receiver]
}

// Local Loki is single-tenant and stays on the Docker-internal observability
// network. Its built-in queue and retry settings provide bounded buffering.
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"

    remote_timeout      = "10s"
    batch_size          = "1MiB"
    batch_wait          = "1s"
    retry_on_http_429   = true
    min_backoff_period  = "1s"
    max_backoff_period  = "30s"
    max_backoff_retries = 10
  }
}
